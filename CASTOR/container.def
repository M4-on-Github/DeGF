Bootstrap: docker
From: pytorch/pytorch:2.0.1-cuda11.7-cudnn8-devel

# Base image already has: Python 3.10, torch 2.0.1+cu117, torchvision, torchaudio.
# We only install the remaining packages here.
#
# INSTALL ORDER MATTERS:
#   1. transformers + tokenizers pinned FIRST so peft cannot upgrade them.
#   2. peft 0.4.0 is the last release that allows transformers>=4.28 (not >=4.35).
#   3. diffusers capped at 0.21.4 for torch 2.0.1 autocast compatibility.

%post
    pip install --no-cache-dir \
        "transformers==4.31.0" \
        "tokenizers==0.13.3" \
        "huggingface-hub>=0.14.1,<0.20" \
        "safetensors>=0.3.1,<0.5"

    pip install --no-cache-dir \
        "peft==0.4.0" \
        "accelerate==0.21.0"

    pip install --no-cache-dir \
        "bitsandbytes==0.41.0" \
        "diffusers==0.21.4" \
        "einops==0.6.1" \
        "einops-exts==0.0.4" \
        "timm==0.9.2" \
        "shortuuid==1.0.11" \
        "sentencepiece==0.1.99" \
        "pillow>=9.4.0,<11" \
        "tqdm>=4.64" \
        "numpy==1.26.4" \
        "scipy==1.11.3" \
        "scikit-learn==1.2.2" \
        "scikit-image==0.21.0" \
        "opencv-python-headless==4.8.1.78" \
        "ftfy==6.1.3" \
        "fairscale==0.4.13" \
        "omegaconf==2.3.0" \
        "pandas>=1.5,<3" \
        "requests>=2.28" \
        "pycocoevalcap==1.2" \
        "pycocotools==2.0.7" \
        "tiktoken>=0.4" \
        "nltk>=3.7"

    # Verify the critical pins survived the install
    python -c "
import tokenizers, transformers, peft
assert tokenizers.__version__.startswith('0.13'), \
    f'tokenizers upgraded to {tokenizers.__version__} — breaks transformers 4.31'
assert transformers.__version__ == '4.31.0', \
    f'transformers is {transformers.__version__} instead of 4.31.0'
assert peft.__version__.startswith('0.4'), \
    f'peft is {peft.__version__} instead of 0.4.x'
print('Version checks passed.')
"

%environment
    export PYTHONUNBUFFERED=1
    export TOKENIZERS_PARALLELISM=false

%labels
    Project CASTOR
    Base pytorch/pytorch:2.0.1-cuda11.7-cudnn8-devel
